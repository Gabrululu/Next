# ─────────────────────────────────────────────────────────────────────────────
# Next — environment template. Copy to `.env` (contracts + scripts) and the
# NEXT_PUBLIC_* block to `web/.env.local`. Never commit real values.
# Chain values for Monad: https://docs.monad.xyz/ai/current-facts.md
# ─────────────────────────────────────────────────────────────────────────────

# ── Chain (scripts + Foundry) ────────────────────────────────────────────────
# Testnet shown. Mainnet: CHAIN_ID=143, RPC_URL=https://rpc.monad.xyz,
# EXPLORER_URL=https://monadvision.com, CHAIN_NAME="Monad Mainnet".
CHAIN_ID=10143
CHAIN_NAME="Monad Testnet"
RPC_URL=https://testnet-rpc.monad.xyz
WS_URL=wss://testnet-rpc.monad.xyz
EXPLORER_URL=https://testnet.monadvision.com
FAUCET_URL=https://faucet.monad.xyz
NATIVE_SYMBOL=MON

# Throwaway deployer key (never a real/mainnet key). Used by forge scripts + /scripts.
PRIVATE_KEY=
DEPLOYER_ADDRESS=

# Filled in after deployment
NEXT_ADDRESS=
NEXT_PASS_ADDRESS=
DISPERSE_ADDRESS=
# Previous deployment kept for read-only history (optional)
LEGACY_NEXT_ADDRESS=

# ── Web app (web/.env.local) — public, shipped to the browser ───────────────
NEXT_PUBLIC_CHAIN_ID=10143
NEXT_PUBLIC_CHAIN_NAME="Monad Testnet"
NEXT_PUBLIC_IS_TESTNET=true
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_EXPLORER_URL=https://testnet.monadvision.com
NEXT_PUBLIC_FAUCET_URL=https://faucet.monad.xyz
# Optional: only after confirming Multicall3 is deployed on the chain
NEXT_PUBLIC_MULTICALL3=
NEXT_PUBLIC_NEXT_ADDRESS=
NEXT_PUBLIC_NEXT_PASS_ADDRESS=
NEXT_PUBLIC_LEGACY_NEXT_ADDRESS=

# ── Integrations (names finalized from each provider's official docs at its step) ──
# Dynamic (step 4) — public environment id; restrict Allowed Origins in the Dynamic dashboard
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=

# Envio (step 6) — public GraphQL endpoint of the hosted indexer
NEXT_PUBLIC_ENVIO_GRAPHQL_URL=

# Alchemy (step 8) — browser key restricted by domain in the Alchemy dashboard; server key unrestricted, server-only
NEXT_PUBLIC_ALCHEMY_RPC_URL=
ALCHEMY_RPC_URL=
ALCHEMY_WEBHOOK_SIGNING_KEY=

# Email opt-in (step 8) — server-only
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RESEND_API_KEY=
EMAIL_FROM=

# Optional: absolute site URL for share images (defaults to Vercel's production domain, then localhost)
NEXT_PUBLIC_SITE_URL=

# Network-fee top-up for email accounts (server-only, TESTNET throwaway key; fund with a little MON).
# Needed because Dynamic's gas-sponsorship delegation contract isn't deployed on Monad testnet.
GAS_TOPUP_PRIVATE_KEY=

# Optional: hide campaigns with id <= N from the landing page (on-chain campaigns cannot be deleted)
NEXT_PUBLIC_HIDE_CAMPAIGNS_UP_TO=
